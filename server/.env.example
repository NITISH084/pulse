# ==========================================
# Server Configuration
# ==========================================

# Application environment: development | production | test
NODE_ENV=development

# Port on which the API server will run
PORT=5000


# ==========================================
# MongoDB Configuration
# ==========================================

# MongoDB connection URI
# For local development, MongoDB runs through Docker on port 27017
MONGO_URI=mongodb://localhost:27017/pulse

# MongoDB database name
MONGO_DB_NAME=pulse


# ==========================================
# PostgreSQL Configuration
# ==========================================

# PostgreSQL host
# Use "localhost" when the application runs on the host machine
PG_HOST=localhost

# PostgreSQL port
PG_PORT=5432

# Database created by the PostgreSQL Docker container
PG_DATABASE=pulse_postgres

# PostgreSQL username
PG_USER=postgres

# PostgreSQL password
# Set this value in your local .env file
PG_PASSWORD=


# ==========================================
# RabbitMQ Configuration
# ==========================================

# RabbitMQ AMQP connection URL
# Format:
# amqp://<username>:<password>@<host>:<port>/<vhost>
RABBITMQ_URL=amqp://api_user:your_rabbitmq_password@localhost:5672/pulse

# Queue used for processing API hit events
RABBITMQ_QUEUE=api_hits


# ==========================================
# JWT Configuration
# ==========================================

# Secret used to sign and verify JWT tokens
# Use a long, random value in your local .env file
JWT_SECRET=your_jwt_secret_here

# JWT token expiration time
JWT_EXPIRES_IN=24h


# ==========================================
# Rate Limiting Configuration
# ==========================================

# Time window for rate limiting in milliseconds
# 60000 ms = 1 minute
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed per client
# within the configured time window
RATE_LIMIT_MAX_REQUESTS=100
